# Copie este archivo como .env y ajuste los valores.
VOTOSEGURO_DATABASE_URL=postgresql+psycopg://votoseguro:votoseguro@localhost:5432/votoseguro
# Clave maestra de 32 bytes en base64. Si se omite, en desarrollo se genera en backend/.master_key.
# VOTOSEGURO_MASTER_KEY=
VOTOSEGURO_ADMIN_CORREO=admin@votoseguro.gov.co
VOTOSEGURO_ADMIN_PASSWORD=Admin2026*
# Crea 60 votantes y 3 elecciones de ejemplo en el primer arranque.
VOTOSEGURO_SEMBRAR_DATOS_DEMO=true
