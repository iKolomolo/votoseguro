{
  "$description": "Design tokens de VotoSeguro, extraídos del Figma 'Sin título' (4fx8drlog3RcIRDYqbG5Rh), página 'Page 1', 18 pantallas. El archivo no tiene variables ni estilos de Figma; estos valores salen del uso real en 1.636 nodos.",
  "color": {
    "$type": "color",
    "brand": {
      "primary":      { "$value": "#003da5", "$description": "Azul institucional: headers, botón activo, pasos, links (71 fills, 41 textos)" },
      "primary-dark": { "$value": "#001a55", "$description": "Fondo del login admin" }
    },
    "neutral": {
      "bg":             { "$value": "#f0f4fa", "$description": "Fondo de la app del votante; separadores de listas" },
      "bg-admin":       { "$value": "#f8fafc", "$description": "Fondo de la app admin" },
      "surface":        { "$value": "#ffffff", "$description": "Tarjetas, inputs, barras" },
      "surface-subtle": { "$value": "#f3f4f6", "$description": "Pills de estado neutras" },
      "surface-muted":  { "$value": "#f9fafb" },
      "border":         { "$value": "#c8d6e8", "$description": "Borde por defecto de tarjetas, inputs y pasos inactivos" },
      "border-subtle":  { "$value": "#e5e7eb" },
      "text":           { "$value": "#0f172a", "$description": "Texto principal y títulos" },
      "text-secondary": { "$value": "#4b5563", "$description": "Texto secundario, el más usado (106)" },
      "text-muted":     { "$value": "#9ca3af", "$description": "Nav inactivo, placeholders, iconos" },
      "text-subtle":    { "$value": "#6b7280" }
    },
    "info": {
      "bg":     { "$value": "#eff6ff", "$description": "LockBadge, botones secundarios azules" },
      "bg-alt": { "$value": "#eef3ff", "$description": "Fondo de icono en StatCard" },
      "border": { "$value": "#bedbff", "$description": "También texto claro sobre azul primario" },
      "text-on-primary":       { "$value": "#dbeafe", "$description": "Subtítulos sobre el header azul" },
      "text-on-primary-muted": { "$value": "#8ec5ff" }
    },
    "success": {
      "base":        { "$value": "#1a7a4a", "$description": "Botón principal (BigButton), estados OK" },
      "text-strong": { "$value": "#15603b" },
      "bg":          { "$value": "#d1fae5" },
      "bg-subtle":   { "$value": "#f0fdf4", "$description": "EccBadge" },
      "border":      { "$value": "#b9f8cf" },
      "border-alpha":{ "$value": "#1a7a4a4d", "$description": "success.base al 30%" }
    },
    "warning": {
      "base":        { "$value": "#f59e0b", "$description": "Punto de estado" },
      "text":        { "$value": "#b45309" },
      "text-strong": { "$value": "#92400e" },
      "bg":          { "$value": "#fef3c7" }
    },
    "danger": {
      "base":   { "$value": "#b91c1c", "$description": "Texto/icono de acciones destructivas" },
      "bg":     { "$value": "#fef2f2" },
      "bg-alt": { "$value": "#fee2e2" },
      "border": { "$value": "#ffc9c9" }
    },
    "accent": {
      "violet": { "$value": "#8b5cf6", "$description": "Color de gráfica / candidato" }
    },
    "on-primary": {
      "white-10": { "$value": "#ffffff1a" },
      "white-15": { "$value": "#ffffff26", "$description": "Botón Volver, inputs del login admin, badge del welcome" },
      "white-20": { "$value": "#ffffff33" },
      "white-80": { "$value": "#ffffffcc", "$description": "Párrafo sobre azul" },
      "white-90": { "$value": "#ffffffe6", "$description": "Botón flotante Admin" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Source Sans 3", "system-ui", "sans-serif"], "$description": "387 de 396 textos" },
      "mono": { "$value": ["Consolas", "ui-monospace", "monospace"], "$description": "IDs de elección, código de comprobante" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "black": { "$value": 900 }
    },
    "size": {
      "$type": "dimension",
      "3xs": { "$value": "9px" },
      "2xs": { "$value": "10px" },
      "xs-plus": { "$value": "11px" },
      "xs":  { "$value": "12px" },
      "sm":  { "$value": "14px" },
      "md":  { "$value": "16px" },
      "lg":  { "$value": "18px" },
      "xl":  { "$value": "20px" },
      "2xl": { "$value": "24px" },
      "3xl": { "$value": "30px" },
      "4xl": { "$value": "36px" }
    }
  },
  "typography": {
    "$type": "typography",
    "display":       { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 900, "fontSize": "36px", "lineHeight": "45px", "letterSpacing": "-0.9px" }, "$description": "Logo 'VotoSeguro' en el welcome" },
    "headline":      { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "24px", "lineHeight": "32px", "letterSpacing": "0" }, "$description": "Confirmar Voto, Voto Registrado" },
    "title":         { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "20px", "lineHeight": "25px", "letterSpacing": "0" }, "$description": "Título del GovHeader" },
    "title-sm":      { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "18px", "lineHeight": "28px", "letterSpacing": "0" }, "$description": "Títulos de tarjeta y texto de BigButton" },
    "title-admin":   { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "18px", "lineHeight": "22.5px", "letterSpacing": "0" }, "$description": "Título del AdminHeader" },
    "stat":          { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 900, "fontSize": "24px", "lineHeight": "24px", "letterSpacing": "0" }, "$description": "Números de StatCard" },
    "body-lg":       { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "16px", "lineHeight": "26px", "letterSpacing": "0" } },
    "body-strong":   { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "16px", "lineHeight": "24px", "letterSpacing": "0" }, "$description": "Títulos de alertas" },
    "input":         { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 500, "fontSize": "16px", "lineHeight": "24px", "letterSpacing": "0" } },
    "body":          { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "0" } },
    "label":         { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "0" }, "$description": "Etiquetas de formulario" },
    "body-sm-strong":{ "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "0" }, "$description": "Encabezados de sección, números de paso" },
    "caption":       { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0" }, "$description": "El estilo más usado (64)" },
    "caption-strong":{ "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0" } },
    "caption-bold":  { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0" }, "$description": "Botones pequeños" },
    "overline":      { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "1.2px", "textTransform": "uppercase" }, "$description": "'VOTOSEGURO COLOMBIA' en el header" },
    "stat-label":    { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0.3px", "textTransform": "uppercase" } },
    "badge":         { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0.6px", "textTransform": "uppercase" }, "$description": "Activa / Próxima / Cerrada" },
    "micro":         { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "11px", "lineHeight": "16.5px", "letterSpacing": "0" } },
    "step-label":    { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "10px", "lineHeight": "12.5px", "letterSpacing": "0" } },
    "eyebrow":       { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 900, "fontSize": "10px", "lineHeight": "15px", "letterSpacing": "1px", "textTransform": "uppercase" }, "$description": "'VOTOSEGURO · ADMIN'" },
    "nav":           { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "9px", "lineHeight": "13.5px", "letterSpacing": "0.225px", "textTransform": "uppercase" }, "$description": "Etiquetas de la bottom nav" },
    "mono":          { "$value": { "fontFamily": "{font.family.mono}", "fontWeight": 400, "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0" } },
    "receipt-code":  { "$value": { "fontFamily": "{font.family.mono}", "fontWeight": 900, "fontSize": "24px", "lineHeight": "32px", "letterSpacing": "2.4px" }, "$description": "Código del comprobante VS-2026-…" }
  },
  "space": {
    "$type": "dimension",
    "0-5": { "$value": "2px" },
    "1":   { "$value": "4px" },
    "1-5": { "$value": "6px" },
    "2":   { "$value": "8px" },
    "2-5": { "$value": "10px" },
    "3":   { "$value": "12px" },
    "3-5": { "$value": "14px" },
    "4":   { "$value": "16px", "$description": "Padding más usado (256)" },
    "5":   { "$value": "20px", "$description": "Padding lateral de pantalla del votante" },
    "6":   { "$value": "24px" },
    "8":   { "$value": "32px" },
    "10":  { "$value": "40px", "$description": "Padding superior del header" },
    "12":  { "$value": "48px" },
    "16":  { "$value": "64px" },
    "24":  { "$value": "96px", "$description": "Reserva inferior para la bottom nav" }
  },
  "radius": {
    "$type": "dimension",
    "xs":   { "$value": "4px" },
    "sm":   { "$value": "6px" },
    "md":   { "$value": "8px", "$description": "Botón Volver, contenedores de icono" },
    "lg":   { "$value": "12px", "$description": "Inputs, botones, StatCard, alertas" },
    "xl":   { "$value": "16px", "$description": "Tarjetas grandes, logo" },
    "full": { "$value": "9999px", "$description": "Pills, badges, pasos, puntos de estado" }
  },
  "border": {
    "$type": "dimension",
    "width": {
      "hairline": { "$value": "1px" },
      "default":  { "$value": "1.75px", "$description": "En Figma aparece como 1.66–1.75px (captura escalada); en código conviene usar 1.5px o 2px" },
      "indicator":{ "$value": "2px", "$description": "Indicador superior del tab activo" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm":  { "$value": [ { "color": "#0000001a", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }, { "color": "#0000001a", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "-1px" } ], "$description": "Tarjetas" },
    "md":  { "$value": [ { "color": "#0000001a", "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-1px" }, { "color": "#0000001a", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-2px" } ] },
    "lg":  { "$value": [ { "color": "#0000001a", "offsetX": "0px", "offsetY": "10px", "blur": "15px", "spread": "-3px" }, { "color": "#0000001a", "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-4px" } ], "$description": "Botón flotante Admin" },
    "xl":  { "$value": [ { "color": "#0000001a", "offsetX": "0px", "offsetY": "20px", "blur": "25px", "spread": "-5px" }, { "color": "#0000001a", "offsetX": "0px", "offsetY": "8px", "blur": "10px", "spread": "-6px" } ] },
    "2xl": { "$value": { "color": "#00000040", "offsetX": "0px", "offsetY": "25px", "blur": "50px", "spread": "-12px" }, "$description": "Logo del welcome" }
  },
  "blur": {
    "$type": "dimension",
    "backdrop": { "$value": "16px" }
  },
  "size": {
    "$type": "dimension",
    "app-max-width":    { "$value": "384px" },
    "button-min-height":{ "$value": "58px", "$description": "BigButton" },
    "input-height":     { "$value": "55px" },
    "step-indicator":   { "$value": "32px" },
    "icon-sm": { "$value": "16px" },
    "icon-md": { "$value": "20px" },
    "icon-lg": { "$value": "22px" }
  }
}
